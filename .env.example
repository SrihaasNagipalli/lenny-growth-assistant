# ─────────────────────────────────────────────────────────────────────────────
# The Lenny Growth Assistant — Environment Configuration
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="The Lenny Growth Assistant"
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Provider Toggle ───────────────────────────────────────────────────────
# Switch between "anthropic" and "ollama" without code changes.
# For the demo, set to "ollama" and ensure Ollama is running.
LLM_PROVIDER=anthropic

# ── Anthropic (Cloud) ─────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Ollama (Local) ────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=ollama
# Install: https://ollama.ai | Run: ollama serve | Pull: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# For Docker Compose, the default below works out of the box.
# For Supabase: use the Supabase connection pooler URL.
# For Railway: use the Railway DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://lenny:lenny_pass@localhost:5432/lenny_db

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=lenny_transcripts

# ── RAG Settings ──────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# ── Transcripts ───────────────────────────────────────────────────────────────
TRANSCRIPTS_DIR=./data/transcripts

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
